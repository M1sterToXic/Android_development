<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#282828"
        android:padding="20dp"
        tools:context=".MainActivity">

    <TextView
            android:id="@+id/textView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Мои Приложения"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <Button
            android:id="@+id/btn_calculator"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:backgroundTint="#40FF00"
            android:text="🧮 Калькулятор"
            android:textColor="#0D0C0C"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView"
            android:layout_marginTop="40dp" />

    <Button
            android:id="@+id/btn_music_player"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:backgroundTint="#40FF00"
            android:text="🎵 Музыкальный Плеер"
            android:textColor="#0D0C0C"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_calculator"
            android:layout_marginTop="15dp" />

    <Button
            android:id="@+id/btn_location"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:backgroundTint="#40FF00"
            android:text="📍 Определение местоположения"
            android:textColor="#0D0C0C"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_music_player"
            android:layout_marginTop="15dp" />

    <Button
            android:id="@+id/btn_sockets"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:backgroundTint="#40FF00"
            android:text="🔌 ZMQ Сокеты"
            android:textColor="#0D0C0C"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_location"
            android:layout_marginTop="15dp" />

    <Button
            android:id="@+id/btn_service_background"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:backgroundTint="#40FF00"
            android:text="📊 Фоновая служба"
            android:textColor="#0D0C0C"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_sockets"
            android:layout_marginTop="15dp" />

</androidx.constraintlayout.widget.ConstraintLayout>